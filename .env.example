# --- Database (Supabase Postgres, pooler URL recommended) ---
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
SUPABASE_URL=https://<ref>.supabase.co
# Fallback if SUPABASE_DB_URL is not set
# DATABASE_URL=

# --- Clerk (operator authentication) ---
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# --- Optional ---
# NVD API key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Directory holding agent binaries + manifest.json (default: ../../agent/dist relative to the API server)
AGENT_DIST_DIR=
# Canonical HTTPS origin embedded in enrollment commands (required in production)
AGENT_PUBLIC_BASE_URL=https://security.example.com
# Optional comma-separated origins only when the SPA is hosted separately from the API
APP_ORIGINS=
SESSION_SECRET=change-me
LOG_LEVEL=info
