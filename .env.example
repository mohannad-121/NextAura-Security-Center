# --- Isolated staging database (Supabase transaction pooler recommended) ---
# Configure the secret value in Vercel Preview settings; never commit it here.
SUPABASE_DB_URL=
# Generic PostgreSQL fallback if SUPABASE_DB_URL is intentionally not used.
# DATABASE_URL=

# --- Clerk (operator authentication) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Public browser configuration. It must belong to the same staging Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional only when deliberately using the Clerk Frontend API proxy.
# VITE_CLERK_PROXY_URL=

# --- Optional ---
# NVD API key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Directory holding agent binaries + manifest.json (default: ../../agent/dist relative to the API server)
AGENT_DIST_DIR=
# Canonical HTTPS origin embedded in enrollment commands (required in production)
AGENT_PUBLIC_BASE_URL=
# Optional comma-separated origins only when the SPA is hosted separately from the API
APP_ORIGINS=
LOG_LEVEL=info
